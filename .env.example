# Google Places API key (optional; real lookup requires this key)
GOOGLE_PLACES_API_KEY=

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Your Name <you@example.com>
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=5

# IMAP settings for reply tracking
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=60

# Enrichment provider
ENRICH_PROVIDER=mock
CLEARBIT_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=change-me
ADMIN_EMAIL=admin@example.com

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/leads_db
# If using Supabase Postgres, set this to your Supabase connection string:
# DATABASE_URL="postgresql://postgres:<password>@<project-ref>.db.supabase.co:5432/postgres"
REDIS_URL=redis://localhost:6379/0

# Celery
USE_CELERY=true

SESSION_SECURE_COOKIE=true
FORCE_HTTPS=false
